# Copy to .env for local development. Never commit real values.
APP_ENV=development
FLASK_APP=wsgi.py
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://ps_app:ps_app@localhost/projectsphere
TEST_DATABASE_URL=postgresql://ps_app:ps_app@localhost/projectsphere_test
REDIS_URL=redis://localhost:6379/0
TRIAL_DAYS=14
# Only used by `flask create-superadmin`
SUPERADMIN_PASSWORD=
SALES_EMAIL=sales@example.com
# Email (optional). Without MAIL_SERVER, invitation links are shown on screen to copy.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Laari ProjectSphere <no-reply@yourdomain.com>
# File storage. "local" keeps files on disk (use a Render persistent disk), "s3" uses S3-compatible object storage.
STORAGE_BACKEND=local
UPLOAD_ROOT=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=20

# Billing and integrations (Stage 11)
APP_BASE_URL=http://localhost:5000
# Paystack secret key (test keys start sk_test_). Leave empty to switch online payment off.
PAYSTACK_SECRET_KEY=
# Shown on invoices for customers paying by bank transfer
PLATFORM_BANK_DETAILS=
INVOICE_DUE_DAYS=7
RENEWAL_NOTICE_DAYS=7
BILLING_GRACE_DAYS=7
